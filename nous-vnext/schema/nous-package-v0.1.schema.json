{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nous.questory.dpdns.org/schema/nous-package-v0.1.schema.json",
  "title": "Nous Package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "contentVersion",
    "title",
    "sources",
    "cards"
  ],
  "properties": {
    "format": {
      "const": "nous-package-v0.1"
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "chunkId",
        "quote"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "chunkId": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sha256",
        "title",
        "chunks"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chunkId",
              "text",
              "index"
            ],
            "properties": {
              "chunkId": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "type",
        "prompt",
        "answer",
        "sourceRefs"
      ],
      "properties": {
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false",
            "fill_blank",
            "short_answer",
            "explanation",
            "analysis"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "explanation": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "cognitiveSkill": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "single_choice",
                  "multiple_choice"
                ]
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardId",
        "title",
        "questions"
      ],
      "properties": {
        "cardId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    }
  }
}
